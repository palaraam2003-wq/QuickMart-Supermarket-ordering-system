{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "RapidMartApplication",
            "request": "launch",
            "mainClass": "com.rapidmart.RapidMartApplication",
            "projectName": "rapid-mart",
            "cwd": "${workspaceFolder}",
            // Needed for SQL Server Windows (integrated) authentication; without it the DB connection fails.
            "vmArgs": "-Djava.library.path=\"${workspaceFolder}/target/native\""
        }
    ]
}